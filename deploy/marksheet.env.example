# Copy to /opt/mt/marksheet.env (chmod 600, owned by marksheet)
# The spreadsheet id is the long code in its URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
MT_SHEET_ID=<the spreadsheet id>
# Service account key; share the spreadsheet with this account as Editor
MT_SA_JSON=/opt/mt/service-account.json
